LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=xiaod
# 若账号不在美区，取消下一行注释并改成对应区域
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

DEEPSEEK_API_KEY=
# ChatOpenAI(base_url=https://api.deepseek.com) 默认 deepseek-chat
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 可选：指定文档创建目录。不填则创建在应用云空间根目录
FEISHU_FOLDER_TOKEN=

WHISPER_MODEL=small
# 本机 ffmpeg 可执行文件。不填则从 PATH 查找
FFMPEG_BIN=ffmpeg

# 运行时数据目录（checkpoint / 下载）
XIAOD_DATA_DIR=data

# 本机控制台
XIAOD_WEB_HOST=127.0.0.1
XIAOD_WEB_PORT=8765
